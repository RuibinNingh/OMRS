[Unit]
Description=OMRS 回环框选检测服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omrs
Group=omrs
# 与 OMRS 使用同一精确发布归档；解释器和训练目录须与部署登记一致。
WorkingDirectory=/opt/omrs/services/boxdetect
ExecStart=/var/lib/omrs-train/.venv/bin/python -m boxdetect_service serve --model-dir /var/lib/omrs-train/managed/active --port 18766 --data-dir /var/lib/omrs-boxdetect --models-dir /var/lib/omrs-train/managed/snapshots
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
CPUQuota=200%
MemoryHigh=512M
MemoryMax=1G
TasksMax=64
Nice=10
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=3
Environment=OPENBLAS_NUM_THREADS=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=omrs-boxdetect
StateDirectoryMode=0700
ReadWritePaths=/var/lib/omrs-boxdetect

[Install]
WantedBy=multi-user.target
